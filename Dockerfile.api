# EarthGlass API: radar, NWS alerts, GFS model layers and program control in one process.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 EARTHGLASS_CACHE_DIR=/data

WORKDIR /app
COPY pyproject.toml README.md hatch_build.py ./
COPY earthglass ./earthglass
RUN pip install ".[weather]"

RUN useradd --system --create-home earthglass && mkdir /data && chown earthglass /data
USER earthglass
VOLUME /data
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"

CMD ["uvicorn", "earthglass.web.app:app", "--host", "0.0.0.0", "--port", "8000"]
