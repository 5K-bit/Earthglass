# Broadcast studio client (operator page and clean program output) behind nginx.
FROM node:22-slim AS build
RUN corepack enable
WORKDIR /src/obeos-earth
COPY obeos-earth/package.json obeos-earth/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY obeos-earth ./
RUN pnpm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/obeos-earth/dist /usr/share/nginx/html
EXPOSE 80
