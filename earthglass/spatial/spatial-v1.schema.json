{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "method": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "value",
        "method"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "Motion": {
      "additionalProperties": false,
      "properties": {
        "heading_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Deg"
        },
        "speed_mps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed Mps"
        },
        "vertical_rate_mps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vertical Rate Mps"
        }
      },
      "title": "Motion",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "altitude_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Altitude M"
        },
        "altitude_reference": {
          "default": "unknown",
          "enum": [
            "ellipsoid",
            "msl",
            "barometric",
            "unknown"
          ],
          "title": "Altitude Reference",
          "type": "string"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "Position",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_url": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "attribution": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "license_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Url"
        }
      },
      "required": [
        "provider",
        "source_id",
        "source_url",
        "attribution"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "entity_id": {
          "maxLength": 250,
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "layer": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Layer",
          "type": "string"
        },
        "entity_type": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "motion": {
          "anyOf": [
            {
              "$ref": "#/$defs/Motion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "measurement_kind": {
          "default": "observed",
          "enum": [
            "observed",
            "predicted",
            "simulated",
            "estimated",
            "catalog"
          ],
          "title": "Measurement Kind",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "entity_id",
        "layer",
        "entity_type",
        "position",
        "observed_at",
        "provenance"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Viewport": {
      "additionalProperties": false,
      "properties": {
        "west": {
          "maximum": 180,
          "minimum": -180,
          "title": "West",
          "type": "number"
        },
        "south": {
          "maximum": 90,
          "minimum": -90,
          "title": "South",
          "type": "number"
        },
        "east": {
          "maximum": 180,
          "minimum": -180,
          "title": "East",
          "type": "number"
        },
        "north": {
          "maximum": 90,
          "minimum": -90,
          "title": "North",
          "type": "number"
        }
      },
      "required": [
        "west",
        "south",
        "east",
        "north"
      ],
      "title": "Viewport",
      "type": "object"
    },
    "ProviderHealth": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "layer": {
          "title": "Layer",
          "type": "string"
        },
        "lifecycle": {
          "default": "disabled",
          "enum": [
            "disabled",
            "idle",
            "loading",
            "running",
            "stopped"
          ],
          "title": "Lifecycle",
          "type": "string"
        },
        "state": {
          "default": "offline",
          "enum": [
            "online",
            "degraded",
            "stale",
            "offline",
            "recovering"
          ],
          "title": "State",
          "type": "string"
        },
        "count": {
          "default": 0,
          "title": "Count",
          "type": "integer"
        },
        "rejected_records": {
          "default": 0,
          "title": "Rejected Records",
          "type": "integer"
        },
        "last_success_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Success At"
        },
        "last_attempt_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Attempt At"
        },
        "next_attempt_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Attempt At"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "message": {
          "default": "Not enabled",
          "title": "Message",
          "type": "string"
        },
        "coverage": {
          "default": "",
          "title": "Coverage",
          "type": "string"
        },
        "attribution": {
          "default": "",
          "title": "Attribution",
          "type": "string"
        },
        "credential_required": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Required"
        },
        "transport": {
          "default": "snapshot",
          "enum": [
            "snapshot",
            "polling",
            "websocket"
          ],
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "layer"
      ],
      "title": "ProviderHealth",
      "type": "object"
    }
  },
  "$ref": "#/$defs/Observation"
}
